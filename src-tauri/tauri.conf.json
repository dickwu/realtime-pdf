{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Realtime PDF",
  "mainBinaryName": "Realtime PDF",
  "version": "0.1.14",
  "identifier": "com.gwddeveloper.realtime-pdf",
  "build": {
    "beforeDevCommand": "bun run dev:tauri",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Realtime PDF",
        "width": 1280,
        "height": 900,
        "minWidth": 960,
        "minHeight": 720,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://cdn.jsdelivr.net; media-src 'self' data: blob: asset: http://asset.localhost; object-src 'self' blob: asset: http://asset.localhost; frame-src 'self' blob: asset: http://asset.localhost; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://cdn.jsdelivr.net;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dickwu/realtime-pdf/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMjZDRTBFQjVCRUU0MDUKUldRRjVMNjFEczRtWWJEYXN1QnZVdy93dnVmSlVzTjJQdk1GMXU2YmRNeVlscDkrSHlnTHY5dHAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
